//OQB - English UI & Export (Text, Diagrams, Options, Attempt Tracking & Wrong-Question Filter)
(() => {
  // 1. State Initialization
  window.autoQuestions = [];
  let isRunning = false;
  let autoTimer = null;
  let showMetaInfo = true;
  let showLevel = true;
  let showTopic = true;
  let answerMode = 'inline'; // 'inline' (Bottom) | 'end' (End) | 'off' (OFF)
  let showUserRecord = true; // Show user's attempt (Correct/Wrong & Your Ans)
  let wrongOnly = false;     // Export wrong questions only

  // Remove existing UI if present
  const oldUI = document.getElementById('oqb-auto-collector-ui');
  if (oldUI) oldUI.remove();

  // 2. Build Control Panel
  const panel = document.createElement('div');
  panel.id = 'oqb-auto-collector-ui';
  panel.style.cssText = `
    position: fixed; bottom: 25px; right: 25px; z-index: 999999;
    background: #0f172a; color: #f8fafc; padding: 16px 20px; border-radius: 14px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.6); border: 1px solid #334155;
    display: flex; flex-direction: column; gap: 8px; font-family: system-ui, -apple-system, sans-serif;
    min-width: 370px; touch-action: none; user-select: none;
  `;

  // Dragging Logic
  let isDragging = false;
  let startX, startY, initialX, initialY;

  const dragStart = (e) => {
    if (e.target.tagName === 'BUTTON') return;
    isDragging = true;
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    startX = clientX;
    startY = clientY;
    const rect = panel.getBoundingClientRect();
    initialX = rect.left;
    initialY = rect.top;
    panel.style.left = initialX + 'px';
    panel.style.top = initialY + 'px';
    panel.style.bottom = 'auto';
    panel.style.right = 'auto';
  };

  const dragMove = (e) => {
    if (!isDragging) return;
    e.preventDefault();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    panel.style.left = (initialX + (clientX - startX)) + 'px';
    panel.style.top = (initialY + (clientY - startY)) + 'px';
  };

  const dragEnd = () => { isDragging = false; };

  panel.addEventListener('mousedown', dragStart);
  document.addEventListener('mousemove', dragMove);
  document.addEventListener('mouseup', dragEnd);
  panel.addEventListener('touchstart', dragStart, { passive: false });
  document.addEventListener('touchmove', dragMove, { passive: false });
  document.addEventListener('touchend', dragEnd);

  // Header Row
  const headerRow = document.createElement('div');
  headerRow.style.cssText = 'display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 8px; cursor: move;';

  const status = document.createElement('span');
  status.style.cssText = 'color: #38bdf8; font-weight: bold; font-size: 13px;';
  const updateStatus = () => {
    const total = window.autoQuestions.length;
    const rightCount = window.autoQuestions.filter(q => q.isUserCorrect === true).length;
    const wrongCount = window.autoQuestions.filter(q => q.isUserCorrect === false).length;
    if (rightCount + wrongCount > 0) {
      status.innerText = `📦 Collected: ${total} (✓ ${rightCount} / ✗ ${wrongCount})`;
    } else {
      const ansCount = window.autoQuestions.filter(q => q.answer).length;
      status.innerText = `📦 Collected: ${total} (Ans: ${ansCount})`;
    }
  };
  updateStatus();

  const modeBadge = document.createElement('span');
  modeBadge.style.cssText = 'background: #334155; color: #cbd5e1; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold;';
  modeBadge.innerText = 'Ready';

  headerRow.appendChild(status);
  headerRow.appendChild(modeBadge);
  panel.appendChild(headerRow);

  // Row 1: Auto vs Manual
  const btnRow1 = document.createElement('div');
  btnRow1.style.cssText = 'display: flex; gap: 8px;';
  const startBtn = document.createElement('button');
  startBtn.innerText = '▶️ Start Auto';
  startBtn.style.cssText = 'flex: 1; background: #0284c7; color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px;';
  const manualSnapBtn = document.createElement('button');
  manualSnapBtn.innerText = '📸 Snap One';
  manualSnapBtn.style.cssText = 'flex: 1; background: #7c3aed; color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px;';
  btnRow1.appendChild(startBtn);
  btnRow1.appendChild(manualSnapBtn);
  panel.appendChild(btnRow1);

  // Row 2a: Meta Toggles
  const btnRow2a = document.createElement('div');
  btnRow2a.style.cssText = 'display: flex; gap: 6px;';

  const toggleMetaBtn = document.createElement('button');
  toggleMetaBtn.innerText = 'Year: ON';
  toggleMetaBtn.style.cssText = 'flex: 1; background: #475569; color: white; border: none; padding: 6px 4px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 11px;';

  const toggleLevelBtn = document.createElement('button');
  toggleLevelBtn.innerText = 'Level: ON';
  toggleLevelBtn.style.cssText = 'flex: 1; background: #475569; color: white; border: none; padding: 6px 4px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 11px;';

  const toggleTopicBtn = document.createElement('button');
  toggleTopicBtn.innerText = 'Topic: ON';
  toggleTopicBtn.style.cssText = 'flex: 1; background: #475569; color: white; border: none; padding: 6px 4px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 11px;';

  btnRow2a.appendChild(toggleMetaBtn);
  btnRow2a.appendChild(toggleLevelBtn);
  btnRow2a.appendChild(toggleTopicBtn);
  panel.appendChild(btnRow2a);

  // Row 2b: Answer, Attempt Record & Filter Toggles
  const btnRow2b = document.createElement('div');
  btnRow2b.style.cssText = 'display: flex; gap: 6px;';

  const toggleAnswerBtn = document.createElement('button');
  toggleAnswerBtn.innerText = 'Ans: Bottom';
  toggleAnswerBtn.style.cssText = 'flex: 1; background: #059669; color: white; border: none; padding: 6px 4px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 11px;';

  const toggleUserRecBtn = document.createElement('button');
  toggleUserRecBtn.innerText = 'Attempt: ON';
  toggleUserRecBtn.style.cssText = 'flex: 1; background: #0d9488; color: white; border: none; padding: 6px 4px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 11px;';

  const toggleWrongOnlyBtn = document.createElement('button');
  toggleWrongOnlyBtn.innerText = 'Filter: All';
  toggleWrongOnlyBtn.style.cssText = 'flex: 1; background: #475569; color: white; border: none; padding: 6px 4px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 11px;';

  btnRow2b.appendChild(toggleAnswerBtn);
  btnRow2b.appendChild(toggleUserRecBtn);
  btnRow2b.appendChild(toggleWrongOnlyBtn);
  panel.appendChild(btnRow2b);

  // Row 3: Clear, PDF, DOCX, Close
  const btnRow3 = document.createElement('div');
  btnRow3.style.cssText = 'display: flex; gap: 6px;';

  const clearBtn = document.createElement('button');
  clearBtn.innerText = '🗑️';
  clearBtn.title = 'Clear All';
  clearBtn.style.cssText = 'background: #dc2626; color: white; border: none; padding: 8px 10px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px;';

  const printBtn = document.createElement('button');
  printBtn.innerText = '🖨️ PDF';
  printBtn.style.cssText = 'flex: 1; background: #22c55e; color: white; border: none; padding: 8px 8px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px;';

  const docxBtn = document.createElement('button');
  docxBtn.innerText = '📄 DOCX';
  docxBtn.style.cssText = 'flex: 1; background: #2563eb; color: white; border: none; padding: 8px 8px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px;';

  const closeBtn = document.createElement('button');
  closeBtn.innerText = '✕';
  closeBtn.title = 'Close Panel';
  closeBtn.style.cssText = 'background: #64748b; color: white; border: none; padding: 8px 10px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px;';

  btnRow3.appendChild(clearBtn);
  btnRow3.appendChild(printBtn);
  btnRow3.appendChild(docxBtn);
  btnRow3.appendChild(closeBtn);
  panel.appendChild(btnRow3);

  document.body.appendChild(panel);

  const escapeHtml = (str = '') =>
    String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

  const ensureAnswerVisible = async () => {
    const hasAnswerOrReview = !!document.querySelector(
      '.oqb-report-correct-answer, .oqb-check-missing, .oqb-player-review-correct, .oqb-player-review-incorrect, .oqb-player-ci-checkerbox .text-success'
    );
    if (hasAnswerOrReview) return;

    const toggleBtn = Array.from(document.querySelectorAll('button')).find(btn => {
      const txt = (btn.innerText || btn.textContent || '').trim();
      return (txt.includes('Toggle Answer') || txt.includes('切換答案顯示')) && btn.clientWidth > 0 && !btn.disabled;
    });

    if (toggleBtn) {
      toggleBtn.click();
      await new Promise(r => setTimeout(r, 350));
    }
  };

  // 3. Scrape Question, Options, User Attempt & Correct Answer
  const scrapeCurrentQuestion = () => {
    panel.style.display = 'none';

    const qData = {
      stem: '',
      stemImgs: [],
      options: [],
      userAnswer: '',
      answer: '',
      isUserCorrect: null,
      meta: '',
      level: '',
      topic: ''
    };

    // A. Meta Info
    const rows = Array.from(document.querySelectorAll('.oqb-paper-info-modal .row, .row'));
    rows.forEach(row => {
      const labelEl = row.querySelector('.col-auto');
      const valEl = row.querySelector('.col');
      if (labelEl && valEl) {
        const text = (labelEl.textContent || '').trim();
        const val = (valEl.textContent || '').trim();
        if (!val) return;
        if (text.includes('備註') || text.includes('Remarks')) qData.meta = val;
        if (text.includes('程度') || text.includes('Level of Difficulty')) qData.level = val;
        if (text.includes('課題') || text.includes('Topic')) qData.topic = val;
      }
    });

    // B. Review Status Banners
    const reviewCorrectEl = document.querySelector('.oqb-player-review-correct');
    const reviewIncorrectEl = document.querySelector('.oqb-player-review-incorrect');

    // C. Options, User Choice & Standard Answer
    const choiceNodes = Array.from(document.querySelectorAll('li.oqb-player-ci-simple-choice'));
    if (choiceNodes.length > 0) {
      qData.options = choiceNodes.map(li => {
        const label = li.querySelector('.oqb-player-ci-simple-choice-label')?.textContent.trim() || '';
        const textEl = li.querySelector('.oqb-player-ci-simple-choice-text');
        const text = textEl ? textEl.innerText.trim() : '';
        const img = li.querySelector('img.oqb-player-content-images, img')?.src || '';

        const isUserChecked = !!li.querySelector('.oqb-player-ci-simple-choice-checkbox.checked');
        const hasCorrectMarker = !!(
          li.querySelector('.oqb-report-correct-answer') ||
          li.querySelector('.oqb-check-missing') ||
          li.querySelector('.oqb-player-ci-checkerbox .text-success') ||
          li.querySelector('.oqb-player-ci-checkerbox [data-icon="circle-check"]') ||
          li.querySelector('.oqb-player-ci-checkerbox [data-icon="hand-point-right"]')
        );

        return { label, text, img, isUserChecked, isCorrect: hasCorrectMarker };
      });

      qData.userAnswer = qData.options
        .filter(o => o.isUserChecked && o.label)
        .map(o => o.label)
        .join(', ');

      let correctList = qData.options.filter(o => o.isCorrect && o.label);
      if (correctList.length === 0 && reviewCorrectEl && qData.userAnswer) {
        qData.options.forEach(o => {
          if (o.isUserChecked) o.isCorrect = true;
        });
        correctList = qData.options.filter(o => o.isCorrect && o.label);
      }

      qData.answer = correctList.map(o => o.label).join(', ');

      if (reviewCorrectEl) {
        qData.isUserCorrect = true;
      } else if (reviewIncorrectEl) {
        qData.isUserCorrect = false;
      } else if (qData.userAnswer && qData.answer) {
        qData.isUserCorrect = (qData.userAnswer === qData.answer);
      }
    }

    // D. Question Stem
    const questionBody = document.querySelector('#oqb-question-body');
    const interaction = document.querySelector('.oqb-player-choice-interaction');
    const contentArea = questionBody || (interaction ? interaction.parentElement : (document.querySelector('.oqb-client-paper-main') || document.body));

    if (contentArea) {
      const clone = contentArea.cloneNode(true);

      const ignoreSelectors = [
        '.oqb-question-nav-list-wrapper', '.oqb-client-paper-top-wrapper',
        '.oqb-client-paper-top-nav-container', '.oqb-client-version-no',
        '.progress-indicator', '#oqb-auto-collector-ui',
        '.oqb-player-choice-interaction', '.dropdown-menu',
        '.oqb-paper-modal-reference', 'button', '.top-nav'
      ];
      ignoreSelectors.forEach(sel => { clone.querySelectorAll(sel).forEach(el => el.remove()); });

      const imgs = Array.from(clone.querySelectorAll('img'))
        .map(i => i.src)
        .filter(src => src && !(src.includes('logo') || src.includes('hkeaa') || src.includes('svg')));
      qData.stemImgs = Array.from(new Set(imgs));

      clone.querySelectorAll('img').forEach(i => i.remove());
      const rawLines = clone.innerText.split('\n').map(l => l.trim()).filter(l => l.length > 0);

      const blackList = [
        '返回', '進度', '試題', '答案不正確', '答案正確', '上一頁', '下一頁',
        '切換答案顯示', '提交', 'Back', 'Progress', 'Question', 'Incorrect', 'Correct',
        'Previous', 'Next', 'Toggle Answer', 'Submit', 'Reference', 'Correct Answer', 'Incorrect Answer'
      ];

      qData.stem = rawLines.filter(line => !blackList.some(kw => line === kw || line.startsWith('Question '))).join('\n');
    }

    panel.style.display = 'flex';

    const isValid = (qData.stem.length > 3 || qData.options.length > 0 || qData.stemImgs.length > 0);
    const isDuplicate = window.autoQuestions.some(q =>
      (q.stem && q.stem === qData.stem && JSON.stringify(q.options) === JSON.stringify(qData.options)) ||
      (q.stemImgs.length > 0 && JSON.stringify(q.stemImgs) === JSON.stringify(qData.stemImgs))
    );

    if (!isDuplicate && isValid) {
      window.autoQuestions.push(qData);
      updateStatus();
      return true;
    }
    return false;
  };

  // 4. Next Page Navigation
  const goToNextPage = () => {
    const directNextBtn = document.querySelector('.oqb-client-paper-main-btn-next-question');
    if (directNextBtn && !directNextBtn.disabled && !directNextBtn.classList.contains('disabled') && directNextBtn.clientWidth > 0) {
      directNextBtn.click();
      return true;
    }

    const allButtons = Array.from(document.querySelectorAll('button'));
    const nextBtn = allButtons.find(btn => {
      const txt = btn.innerText ? btn.innerText.trim() : '';
      return (txt === 'Next' || txt === '下一頁' || txt === '下一題') &&
        btn.clientWidth > 0 && !btn.disabled && !btn.classList.contains('disabled');
    });

    if (nextBtn) {
      nextBtn.click();
      return true;
    }

    const currentActiveNav = document.querySelector('.oqb-question-nav-box.active');
    if (currentActiveNav && currentActiveNav.nextElementSibling) {
      const nextLi = currentActiveNav.nextElementSibling;
      if (!nextLi.classList.contains('disabled') && !nextLi.querySelector('.fa-angle-right') && !nextLi.querySelector('.fa-angles-right')) {
        const nextLink = nextLi.querySelector('a');
        if (nextLink) {
          nextLink.click();
          return true;
        }
      }
    }
    return false;
  };

  const runAutoLoop = async () => {
    if (!isRunning) return;
    await ensureAnswerVisible();
    if (!isRunning) return;

    scrapeCurrentQuestion();

    if (goToNextPage()) {
      autoTimer = setTimeout(runAutoLoop, 2500);
    } else {
      isRunning = false;
      startBtn.innerText = '▶️ Start Auto';
      startBtn.style.background = '#0284c7';
      modeBadge.innerText = 'Done';
      updateStatus();
      alert('🎉 All questions collected!');
    }
  };

  // 5. Button Events
  startBtn.onclick = () => {
    isRunning = !isRunning;
    if (isRunning) {
      startBtn.innerText = '⏸️ Pause';
      startBtn.style.background = '#eab308';
      modeBadge.innerText = 'Running';
      runAutoLoop();
    } else {
      startBtn.innerText = '▶️ Start Auto';
      startBtn.style.background = '#0284c7';
      modeBadge.innerText = 'Paused';
      clearTimeout(autoTimer);
      updateStatus();
    }
  };

  manualSnapBtn.onclick = async () => {
    if (isRunning) { alert('⚠️ Please pause Auto mode first!'); return; }
    await ensureAnswerVisible();
    if (scrapeCurrentQuestion()) {
      alert('📸 Question captured!');
    } else {
      alert('⚠️ Already captured or invalid content.');
    }
  };

  toggleMetaBtn.onclick = () => {
    showMetaInfo = !showMetaInfo;
    toggleMetaBtn.innerText = `Year: ${showMetaInfo ? 'ON' : 'OFF'}`;
    toggleMetaBtn.style.background = showMetaInfo ? '#475569' : '#334155';
  };

  toggleLevelBtn.onclick = () => {
    showLevel = !showLevel;
    toggleLevelBtn.innerText = `Level: ${showLevel ? 'ON' : 'OFF'}`;
    toggleLevelBtn.style.background = showLevel ? '#475569' : '#334155';
  };

  toggleTopicBtn.onclick = () => {
    showTopic = !showTopic;
    toggleTopicBtn.innerText = `Topic: ${showTopic ? 'ON' : 'OFF'}`;
    toggleTopicBtn.style.background = showTopic ? '#475569' : '#334155';
  };

  toggleAnswerBtn.onclick = () => {
    if (answerMode === 'inline') {
      answerMode = 'end';
      toggleAnswerBtn.innerText = 'Ans: End';
      toggleAnswerBtn.style.background = '#0284c7';
    } else if (answerMode === 'end') {
      answerMode = 'off';
      toggleAnswerBtn.innerText = 'Ans: OFF';
      toggleAnswerBtn.style.background = '#334155';
    } else {
      answerMode = 'inline';
      toggleAnswerBtn.innerText = 'Ans: Bottom';
      toggleAnswerBtn.style.background = '#059669';
    }
  };

  toggleUserRecBtn.onclick = () => {
    showUserRecord = !showUserRecord;
    toggleUserRecBtn.innerText = `Attempt: ${showUserRecord ? 'ON' : 'OFF'}`;
    toggleUserRecBtn.style.background = showUserRecord ? '#0d9488' : '#334155';
  };

  toggleWrongOnlyBtn.onclick = () => {
    wrongOnly = !wrongOnly;
    toggleWrongOnlyBtn.innerText = wrongOnly ? 'Filter: Wrong' : 'Filter: All';
    toggleWrongOnlyBtn.style.background = wrongOnly ? '#e11d48' : '#475569';
  };

  clearBtn.onclick = () => {
    if (confirm('🗑️ Clear all collected questions?')) {
      window.autoQuestions = [];
      updateStatus();
      modeBadge.innerText = 'Cleared';
    }
  };

  const getExportList = () => {
    if (!wrongOnly) return window.autoQuestions;
    return window.autoQuestions.filter(q => q.isUserCorrect === false);
  };

  // 6. PDF Export
  printBtn.onclick = () => {
    const list = getExportList();
    if (list.length === 0) {
      alert(wrongOnly ? '⚠️ No wrong questions collected!' : '⚠️ No questions collected yet!');
      return;
    }

    let topicName = list.find(q => q.topic)?.topic || 'DSE_Questions';
    topicName = topicName.trim() || 'DSE_Questions';
    const dynamicTitle = wrongOnly ? `${topicName} Wrong Questions` : `${topicName} MC`;

    const printWindow = window.open('', '_blank');

    let html = `
      <!DOCTYPE html>
      <html>
      <head>
        <title>${escapeHtml(dynamicTitle)}</title>
        <style>
          body { font-family: system-ui, -apple-system, sans-serif; padding: 40px; background: #fff; color: #1e293b; max-width: 800px; margin: 0 auto; }
          .q-card { page-break-inside: avoid; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 2px solid #e2e8f0; }
          .q-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 10px; }
          .q-num { font-size: 16px; font-weight: bold; color: #0284c7; white-space: nowrap; }
          .q-badges { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
          .q-meta { font-size: 12px; font-weight: bold; color: #475569; background: #f1f5f9; padding: 2px 8px; border-radius: 4px; border: 1px solid #cbd5e1; }
          .q-stem { font-size: 16px; line-height: 1.6; white-space: pre-wrap; margin-bottom: 14px; }
          .img-row { display: flex; align-items: center; margin-bottom: 12px; }
          .q-options { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
          .opt-row { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; }
          .opt-label { font-weight: bold; min-width: 24px; color: #334155; }
          .opt-content { flex: 1; }
          .q-ans-bottom { display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
          .q-ans-box {
            display: inline-block; min-width: 28px; text-align: center;
            padding: 3px 12px; border: 2px solid #0284c7; border-radius: 6px;
            color: #0284c7; font-weight: bold; font-size: 14px;
            background: #f0f9ff; -webkit-print-color-adjust: exact; print-color-adjust: exact;
          }
          .q-user-right {
            display: inline-block; padding: 3px 10px; border: 2px solid #16a34a; border-radius: 6px;
            color: #15803d; font-weight: bold; font-size: 14px;
            background: #f0fdf4; -webkit-print-color-adjust: exact; print-color-adjust: exact;
          }
          .q-user-wrong {
            display: inline-block; padding: 3px 10px; border: 2px solid #dc2626; border-radius: 6px;
            color: #dc2626; font-weight: bold; font-size: 14px;
            background: #fef2f2; -webkit-print-color-adjust: exact; print-color-adjust: exact;
          }
          .q-user-neutral {
            display: inline-block; padding: 3px 10px; border: 2px solid #64748b; border-radius: 6px;
            color: #475569; font-weight: bold; font-size: 14px;
            background: #f8fafc; -webkit-print-color-adjust: exact; print-color-adjust: exact;
          }
          .answer-key-page { page-break-before: always; padding-top: 20px; }
          .answer-key-title { font-size: 20px; font-weight: bold; color: #0f172a; margin-bottom: 8px; border-bottom: 2px solid #0284c7; padding-bottom: 8px; }
          .answer-summary { font-size: 14px; color: #475569; margin-bottom: 16px; font-weight: bold; }
          .answer-table { width: 100%; border-collapse: collapse; font-size: 14px; }
          .answer-table th, .answer-table td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: center; }
          .answer-table th { background: #f1f5f9; color: #0f172a; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
          .txt-right { color: #15803d; font-weight: bold; }
          .txt-wrong { color: #dc2626; font-weight: bold; }
          .txt-std { color: #0284c7; font-weight: bold; }
          img { max-width: 100%; height: auto; display: block; }
          @media print { .q-card { border-bottom: 1px solid #cbd5e1; } }
        </style>
      </head>
      <body>
    `;

    list.forEach((q, idx) => {
      html += `<div class="q-card">`;
      html += `<div class="q-header">`;
      html += `<div class="q-num">Question ${idx + 1}</div>`;
      html += `<div class="q-badges">`;
      if (showTopic && q.topic) html += `<div class="q-meta">${escapeHtml(q.topic)}</div>`;
      if (showLevel && q.level) html += `<div class="q-meta">${escapeHtml(q.level)}</div>`;
      if (showMetaInfo && q.meta) html += `<div class="q-meta">${escapeHtml(q.meta)}</div>`;
      html += `</div></div>`;

      if (q.stem) html += `<div class="q-stem">${escapeHtml(q.stem)}</div>`;

      if (q.stemImgs && q.stemImgs.length > 0) {
        q.stemImgs.forEach(imgUrl => {
          html += `<div class="img-row"><img src="${escapeHtml(imgUrl)}" /></div>`;
        });
      }

      if (q.options && q.options.length > 0) {
        html += `<div class="q-options">`;
        q.options.forEach(opt => {
          html += `<div class="opt-row">`;
          html += `<span class="opt-label">${escapeHtml(opt.label)}.</span>`;
          html += `<div class="opt-content">`;
          if (opt.text) html += `<span>${escapeHtml(opt.text)}</span>`;
          if (opt.img) html += `<img src="${escapeHtml(opt.img)}" />`;
          html += `</div></div>`;
        });
        html += `</div>`;
      }

      // Bottom-Right: Attempt & Standard Answer
      const hasUserBlock = showUserRecord && (q.userAnswer || q.isUserCorrect !== null);
      const hasStdBlock = answerMode === 'inline' && q.answer;

      if (hasUserBlock || hasStdBlock) {
        html += `<div class="q-ans-bottom">`;
        if (hasUserBlock) {
          if (q.isUserCorrect === true) {
            html += `<span class="q-user-right">✓ Correct | Yours: ${escapeHtml(q.userAnswer || '-')}</span>`;
          } else if (q.isUserCorrect === false) {
            html += `<span class="q-user-wrong">✗ Wrong | Yours: ${escapeHtml(q.userAnswer || '-')}</span>`;
          } else if (q.userAnswer) {
            html += `<span class="q-user-neutral">Yours: ${escapeHtml(q.userAnswer)}</span>`;
          }
        }
        if (hasStdBlock) {
          const labelPrefix = hasUserBlock ? 'Ans: ' : '';
          html += `<span class="q-ans-box">${labelPrefix}${escapeHtml(q.answer)}</span>`;
        }
        html += `</div>`;
      }

      html += `</div>`;
    });

    // End-of-document Answer Key Table
    if (answerMode === 'end') {
      const rightCount = list.filter(q => q.isUserCorrect === true).length;
      const wrongCount = list.filter(q => q.isUserCorrect === false).length;

      html += `<div class="answer-key-page">`;
      html += `<div class="answer-key-title">Answer Key (${escapeHtml(dynamicTitle)})</div>`;
      if (showUserRecord && (rightCount + wrongCount > 0)) {
        html += `<div class="answer-summary">Total: ${list.length} | Correct: ${rightCount} | Wrong: ${wrongCount}</div>`;
      }
      html += `<table class="answer-table"><thead><tr><th>No.</th>`;
      if (showUserRecord) html += `<th>Result</th><th>Your Ans</th>`;
      html += `<th>Correct Ans</th></tr></thead><tbody>`;

      list.forEach((q, idx) => {
        html += `<tr><td><strong>Q${idx + 1}</strong></td>`;
        if (showUserRecord) {
          const resHtml = q.isUserCorrect === true
            ? `<span class="txt-right">✓ Correct</span>`
            : (q.isUserCorrect === false ? `<span class="txt-wrong">✗ Wrong</span>` : '-');
          html += `<td>${resHtml}</td><td>${escapeHtml(q.userAnswer || '-')}</td>`;
        }
        html += `<td class="txt-std">${escapeHtml(q.answer || 'N/A')}</td></tr>`;
      });

      html += `</tbody></table></div>`;
    }

    html += `<script>window.onload = () => { setTimeout(() => { window.print(); }, 600); };<\/script></body></html>`;
    printWindow.document.write(html);
    printWindow.document.close();
  };

  // 7. CORS Bypass Image Fetcher
  const fetchImageWithCorsBypass = async (imgUrl) => {
    let blob = null;
    try {
      const res = await fetch(imgUrl);
      if (res.ok) blob = await res.blob();
    } catch (e) {}

    if (!blob) {
      try {
        const res = await fetch(`https://images.weserv.nl/?url=${encodeURIComponent(imgUrl)}`);
        if (res.ok) blob = await res.blob();
      } catch (e) {}
    }

    if (!blob) {
      try {
        const res = await fetch(`https://corsproxy.io/?${encodeURIComponent(imgUrl)}`);
        if (res.ok) blob = await res.blob();
      } catch (e) {}
    }

    if (!blob) throw new Error('Image download failed');

    const objectUrl = URL.createObjectURL(blob);
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth || 450;
          canvas.height = img.naturalHeight || 250;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0);
          URL.revokeObjectURL(objectUrl);

          canvas.toBlob(async (pngBlob) => {
            if (!pngBlob) {
              const buf = await blob.arrayBuffer();
              return resolve({ data: new Uint8Array(buf), width: canvas.width, height: canvas.height });
            }
            const buf = await pngBlob.arrayBuffer();
            resolve({ data: new Uint8Array(buf), width: canvas.width, height: canvas.height });
          }, 'image/png');
        } catch (e) {
          URL.revokeObjectURL(objectUrl);
          reject(e);
        }
      };
      img.onerror = (err) => {
        URL.revokeObjectURL(objectUrl);
        reject(err);
      };
      img.src = objectUrl;
    });
  };

  // 8. DOCX Export
  docxBtn.onclick = async () => {
    const list = getExportList();
    if (list.length === 0) {
      alert(wrongOnly ? '⚠️ No wrong questions collected!' : '⚠️ No questions collected yet!');
      return;
    }

    docxBtn.innerText = '⏳ Generating...';
    docxBtn.disabled = true;

    try {
      if (!window.docx) {
        await new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://cdn.jsdelivr.net/npm/docx@8.5.0/build/index.umd.js';
          script.onload = resolve;
          script.onerror = () => reject(new Error('Failed to load docx.js library.'));
          document.head.appendChild(script);
        });
      }

      const {
        Document, Packer, Paragraph, TextRun, ImageRun, HeadingLevel,
        AlignmentType, Table, TableRow, TableCell, WidthType, BorderStyle
      } = window.docx;

      let topicName = list.find(q => q.topic)?.topic || 'DSE_Questions';
      topicName = topicName.trim() || 'DSE_Questions';
      const docTitle = wrongOnly ? `${topicName} Wrong Questions` : `${topicName} MC`;

      const docChildren = [];

      docChildren.push(
        new Paragraph({
          text: docTitle,
          heading: HeadingLevel.HEADING_1,
          alignment: AlignmentType.CENTER,
          spacing: { after: 300 },
        })
      );

      for (let idx = 0; idx < list.length; idx++) {
        const q = list[idx];

        const headerRuns = [
          new TextRun({
            text: `Question ${idx + 1}  `,
            bold: true,
            size: 24,
            color: '0284c7',
          }),
        ];

        const badges = [];
        if (showTopic && q.topic) badges.push(`${q.topic}`);
        if (showLevel && q.level) badges.push(`${q.level}`);
        if (showMetaInfo && q.meta) badges.push(`${q.meta}`);

        if (badges.length > 0) {
          headerRuns.push(
            new TextRun({
              text: `[ ${badges.join(' | ')} ]`,
              size: 18,
              color: '64748b',
              italics: true,
            })
          );
        }

        docChildren.push(
          new Paragraph({
            children: headerRuns,
            spacing: { before: 240, after: 120 },
          })
        );

        // Stem Text
        if (q.stem) {
          const lines = q.stem.split('\n');
          lines.forEach(line => {
            docChildren.push(
              new Paragraph({
                children: [new TextRun({ text: line, size: 22 })],
                spacing: { after: 80 },
              })
            );
          });
        }

        // Stem Images
        if (q.stemImgs && q.stemImgs.length > 0) {
          for (const imgUrl of q.stemImgs) {
            try {
              const processedImg = await fetchImageWithCorsBypass(imgUrl);
              let width = processedImg.width;
              let height = processedImg.height;
              const maxAllowedWidth = 480;
              if (width > maxAllowedWidth) {
                height = Math.round((height * maxAllowedWidth) / width);
                width = maxAllowedWidth;
              }
              docChildren.push(
                new Paragraph({
                  children: [
                    new ImageRun({
                      data: processedImg.data,
                      transformation: { width: Math.round(width), height: Math.round(height) },
                    }),
                  ],
                  spacing: { after: 140 },
                })
              );
            } catch (err) {
              console.warn('DOCX stem image failed:', imgUrl);
            }
          }
        }

        // Options List
        if (q.options && q.options.length > 0) {
          for (const opt of q.options) {
            const optRuns = [
              new TextRun({
                text: `${opt.label}.  `,
                bold: true,
                size: 22,
                color: '1E293B',
              }),
            ];

            if (opt.text) {
              optRuns.push(new TextRun({ text: opt.text, size: 22 }));
            }

            if (opt.img) {
              try {
                const processedOptImg = await fetchImageWithCorsBypass(opt.img);
                let width = processedOptImg.width;
                let height = processedOptImg.height;
                const maxAllowedWidth = 350;
                if (width > maxAllowedWidth) {
                  height = Math.round((height * maxAllowedWidth) / width);
                  width = maxAllowedWidth;
                }
                optRuns.push(
                  new ImageRun({
                    data: processedOptImg.data,
                    transformation: { width: Math.round(width), height: Math.round(height) },
                  })
                );
              } catch (err) {
                console.warn('DOCX option image failed:', opt.img);
              }
            }

            docChildren.push(
              new Paragraph({
                children: optRuns,
                spacing: { after: 70 },
                indent: { left: 360 },
              })
            );
          }
        }

        // Bottom-Right Boxes: Attempt & Standard Answer
        const hasUserBlock = showUserRecord && (q.userAnswer || q.isUserCorrect !== null);
        const hasStdBlock = answerMode === 'inline' && q.answer;

        if (hasUserBlock || hasStdBlock) {
          const rowCells = [];

          if (hasUserBlock) {
            let userText = '';
            let uColor = '475569';
            let uFill = 'F8FAFC';

            if (q.isUserCorrect === true) {
              userText = `✓ Correct | Yours: ${q.userAnswer || '-'}`;
              uColor = '15803D';
              uFill = 'F0FDF4';
            } else if (q.isUserCorrect === false) {
              userText = `✗ Wrong | Yours: ${q.userAnswer || '-'}`;
              uColor = 'DC2626';
              uFill = 'FEF2F2';
            } else if (q.userAnswer) {
              userText = `Yours: ${q.userAnswer}`;
            }

            if (userText) {
              rowCells.push(
                new TableCell({
                  width: { size: 2600, type: WidthType.DXA },
                  margins: { top: 60, bottom: 60, left: 120, right: 120 },
                  shading: { fill: uFill },
                  borders: {
                    top: { style: BorderStyle.SINGLE, size: 10, color: uColor },
                    bottom: { style: BorderStyle.SINGLE, size: 10, color: uColor },
                    left: { style: BorderStyle.SINGLE, size: 10, color: uColor },
                    right: { style: BorderStyle.SINGLE, size: 10, color: uColor },
                  },
                  children: [
                    new Paragraph({
                      alignment: AlignmentType.CENTER,
                      children: [new TextRun({ text: userText, bold: true, size: 20, color: uColor })],
                    }),
                  ],
                })
              );
            }
          }

          if (hasUserBlock && hasStdBlock && rowCells.length > 0) {
            rowCells.push(
              new TableCell({
                width: { size: 140, type: WidthType.DXA },
                borders: {
                  top: { style: BorderStyle.NONE },
                  bottom: { style: BorderStyle.NONE },
                  left: { style: BorderStyle.NONE },
                  right: { style: BorderStyle.NONE },
                },
                children: [new Paragraph({ text: '' })],
              })
            );
          }

          if (hasStdBlock) {
            const stdLabel = hasUserBlock ? `Ans: ${q.answer}` : q.answer;
            const stdWidth = stdLabel.length > 3 ? 1400 : 750;
            rowCells.push(
              new TableCell({
                width: { size: stdWidth, type: WidthType.DXA },
                margins: { top: 60, bottom: 60, left: 120, right: 120 },
                shading: { fill: 'F0F9FF' },
                borders: {
                  top: { style: BorderStyle.SINGLE, size: 12, color: '0284C7' },
                  bottom: { style: BorderStyle.SINGLE, size: 12, color: '0284C7' },
                  left: { style: BorderStyle.SINGLE, size: 12, color: '0284C7' },
                  right: { style: BorderStyle.SINGLE, size: 12, color: '0284C7' },
                },
                children: [
                  new Paragraph({
                    alignment: AlignmentType.CENTER,
                    children: [new TextRun({ text: stdLabel, bold: true, size: 22, color: '0284C7' })],
                  }),
                ],
              })
            );
          }

          if (rowCells.length > 0) {
            docChildren.push(
              new Table({
                alignment: AlignmentType.RIGHT,
                rows: [new TableRow({ children: rowCells })],
              })
            );
          }
        }

        // Divider Line
        docChildren.push(
          new Paragraph({
            text: '',
            border: {
              bottom: {
                color: 'CBD5E1',
                space: 1,
                value: 'single',
                size: 6,
              },
            },
            spacing: { before: 80, after: 200 },
          })
        );
      }

      // End-of-document Answer Key Table
      if (answerMode === 'end') {
        const rightCount = list.filter(q => q.isUserCorrect === true).length;
        const wrongCount = list.filter(q => q.isUserCorrect === false).length;

        docChildren.push(
          new Paragraph({
            text: `Answer Key (${docTitle})`,
            heading: HeadingLevel.HEADING_1,
            pageBreakBefore: true,
            spacing: { after: 120 },
          })
        );

        if (showUserRecord && (rightCount + wrongCount > 0)) {
          docChildren.push(
            new Paragraph({
              children: [
                new TextRun({
                  text: `Total: ${list.length} | Correct: ${rightCount} | Wrong: ${wrongCount}`,
                  bold: true,
                  size: 22,
                  color: '475569',
                }),
              ],
              spacing: { after: 200 },
            })
          );
        }

        const makeCell = (text, color = '1E293B', bold = false, fill = undefined) =>
          new TableCell({
            margins: { top: 80, bottom: 80, left: 120, right: 120 },
            shading: fill ? { fill } : undefined,
            borders: {
              top: { style: BorderStyle.SINGLE, size: 6, color: 'CBD5E1' },
              bottom: { style: BorderStyle.SINGLE, size: 6, color: 'CBD5E1' },
              left: { style: BorderStyle.SINGLE, size: 6, color: 'CBD5E1' },
              right: { style: BorderStyle.SINGLE, size: 6, color: 'CBD5E1' },
            },
            children: [
              new Paragraph({
                alignment: AlignmentType.CENTER,
                children: [new TextRun({ text, bold, size: 20, color })],
              }),
            ],
          });

        const headerCells = [makeCell('No.', '0F172A', true, 'F1F5F9')];
        if (showUserRecord) {
          headerCells.push(makeCell('Result', '0F172A', true, 'F1F5F9'));
          headerCells.push(makeCell('Your Ans', '0F172A', true, 'F1F5F9'));
        }
        headerCells.push(makeCell('Correct Ans', '0F172A', true, 'F1F5F9'));

        const tableRows = [new TableRow({ children: headerCells })];

        list.forEach((q, idx) => {
          const cells = [makeCell(`Q${idx + 1}`, '1E293B', true)];
          if (showUserRecord) {
            if (q.isUserCorrect === true) {
              cells.push(makeCell('✓ Correct', '15803D', true));
            } else if (q.isUserCorrect === false) {
              cells.push(makeCell('✗ Wrong', 'DC2626', true));
            } else {
              cells.push(makeCell('-', '64748B', false));
            }
            cells.push(makeCell(q.userAnswer || '-', '334155', false));
          }
          cells.push(makeCell(q.answer || 'N/A', '0284C7', true));
          tableRows.push(new TableRow({ children: cells }));
        });

        docChildren.push(
          new Table({
            width: { size: 100, type: WidthType.PERCENTAGE },
            rows: tableRows,
          })
        );
      }

      docxBtn.innerText = '⏳ Packing...';

      const doc = new Document({
        sections: [{ properties: {}, children: docChildren }],
      });

      const blob = await Packer.toBlob(doc);
      const downloadUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = downloadUrl;
      a.download = `${docTitle.replace(/\s+/g, '_')}.docx`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(downloadUrl);

    } catch (err) {
      console.error(err);
      alert('❌ DOCX export failed: ' + err.message);
    } finally {
      docxBtn.innerText = '📄 DOCX';
      docxBtn.disabled = false;
    }
  };

  closeBtn.onclick = () => {
    isRunning = false;
    clearTimeout(autoTimer);
    panel.remove();
  };

  console.log('✅ OQB Capture tools (English UI & Export) loaded');
})();
